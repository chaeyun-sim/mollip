# https://developers.kakao.com — 내 애플리케이션 > 앱 키 > JavaScript 키 (카카오톡 공유 fallback)
EXPO_PUBLIC_KAKAO_JS_KEY=
# https://developers.kakao.com — 내 애플리케이션 > 앱 키 > REST API 키 (장소 검색 — 서버 사이드 전용)
# Supabase Dashboard > Edge Functions > kakao-local-search > Secrets 에 등록:
#   KAKAO_API_KEY=<REST API 키>  ← 절대 EXPO_PUBLIC_ 접두사 사용 금지 (앱 번들 노출 위험)
EXPO_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Supabase Auth OAuth redirect (앱 scheme aaa://auth/callback — Dashboard Redirect URLs에 등록)
# https://lab.odsay.com/ 에서 앱 등록 후 발급 (도보/대중교통 길찾기 — 도보/버스/지하철)
EXPO_PUBLIC_ODSAY_API_KEY=
# https://www.data.go.kr/data/15057017/openapi.do — 도로명주소 검색 (승인키, 문화 API key와 별도)
EXPO_PUBLIC_JUSO_CONFIRM_KEY=
# https://developers.naver.com/apps — 지역검색 API (애플리케이션 > 클라이언트 ID/Secret)
# Client ID는 앱에서 직접 사용하지 않음 (Edge Function에서 관리)
# Supabase Dashboard > Edge Functions > naver-local-search > Secrets 에 아래 두 값 등록:
#   NAVER_CLIENT_ID=<클라이언트 ID>
#   NAVER_CLIENT_SECRET=<클라이언트 Secret>  ← 절대 EXPO_PUBLIC_ 접두사 사용 금지
# https://www.culture.go.kr/data/openapi/openapiView.do?id=44 — 국립현대미술관 전시정보(moca/docMeta)
# scripts/sync_kcisa_moca_exhibitions.py 에서만 사용 (앱 런타임 미사용)
EXPO_KOREAN_CONTEMPORARY_MUSEUM_API_KEY=
# https://www.culture.go.kr/data/openapi/openapiView.do?id=611 — 예술의전당 전시정보(API_CCA_149)
# scripts/sync_sac_exhibitions.py 에서만 사용 (앱 런타임 미사용)
EXPO_SAC_API_KEY=
